# anywin - static Windows PE -> Linux ELF relinker
CC      ?= gcc
BUILD   ?= build
CFLAGS  ?= -O2 -g
RTFLAGS  = $(CFLAGS) -Wall -Wno-unused-function -Wno-unused-variable -fno-pie -fno-stack-protector \
           -fcf-protection=none -fno-strict-aliasing -D_FILE_OFFSET_BITS=64 -Iruntime
TOOLFLAGS = $(CFLAGS) -Wall

RT_SRCS := $(wildcard runtime/*.c) $(wildcard runtime/controls/*.c)
RT_OBJS := $(patsubst runtime/%.c,$(BUILD)/rt/%.o,$(RT_SRCS))
RT_HDRS := $(wildcard runtime/*.h) $(wildcard runtime/controls/*.h)

all: $(BUILD)/anywin $(BUILD)/libanywin.o

$(BUILD)/anywin: tool/anywin.c runtime/modmap.h
	@mkdir -p $(dir $@)
	$(CC) $(TOOLFLAGS) -o $@ tool/anywin.c

$(BUILD)/rt/%.o: runtime/%.c $(RT_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(RTFLAGS) -c -o $@ $<

# the runtime is one relocatable object so that its strong definitions
# always override the weak "unimplemented" stubs generated by the relinker
$(BUILD)/libanywin.o: $(RT_OBJS)
	ld -r -o $@ $(RT_OBJS)

# relink every tests/*.exe (built by tests/build.sh with mingw) into $(BUILD)/tests/
test: all
	tests/run.sh $(BUILD)

clean:
	rm -rf $(BUILD)

.PHONY: all clean test
