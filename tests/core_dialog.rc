/* Dialog templates for tests/core_dialog_probe.c: one used through the A calls, one through the W calls. */
#include <windows.h>
#include <commctrl.h>
#define IDC_TREE 101
#define IDC_LBL 102
#define IDC_EDIT 103
#define IDC_CHK 104
#define IDC_RAD1 105
#define IDC_GRP 106
#define IDD_ANSI 200
#define IDD_WIDE 201

IDD_ANSI DIALOG 0, 0, 200, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ansi Dialog"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_TREE, "SysTreeView32", WS_BORDER | WS_TABSTOP | TVS_HASLINES | TVS_HASBUTTONS | TVS_SHOWSELALWAYS, 4, 4, 60, 80
    LTEXT "Host Name", IDC_LBL, 70, 4, 50, 10
    EDITTEXT IDC_EDIT, 70, 16, 120, 14, WS_TABSTOP
    CHECKBOX "Check me", IDC_CHK, 70, 36, 80, 10, WS_TABSTOP
    AUTORADIOBUTTON "Radio", IDC_RAD1, 70, 50, 80, 10, WS_GROUP | WS_TABSTOP
    GROUPBOX "Group", IDC_GRP, 70, 64, 120, 30
    DEFPUSHBUTTON "OK", IDOK, 90, 100, 50, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 146, 100, 50, 14, WS_TABSTOP
END

IDD_WIDE DIALOG 0, 0, 200, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Wide Dialog"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_TREE, "SysTreeView32", WS_BORDER | WS_TABSTOP | TVS_HASLINES | TVS_HASBUTTONS | TVS_SHOWSELALWAYS, 4, 4, 60, 80
    LTEXT "Host Name", IDC_LBL, 70, 4, 50, 10
    EDITTEXT IDC_EDIT, 70, 16, 120, 14, WS_TABSTOP
    CHECKBOX "Check me", IDC_CHK, 70, 36, 80, 10, WS_TABSTOP
    AUTORADIOBUTTON "Radio", IDC_RAD1, 70, 50, 80, 10, WS_GROUP | WS_TABSTOP
    GROUPBOX "Group", IDC_GRP, 70, 64, 120, 30
    DEFPUSHBUTTON "OK", IDOK, 90, 100, 50, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 146, 100, 50, 14, WS_TABSTOP
END
