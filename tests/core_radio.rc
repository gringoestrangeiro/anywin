/* Radio-group probe dialog for tests/core_radio.sh (ids are shared with core_radio_probe.c) */
#include <windows.h>
#define IDD_RADIO 100
#define IDC_A1 201
#define IDC_A2 202
#define IDC_A3 203
#define IDC_B1 211
#define IDC_B2 212
#define IDC_C1 221
#define IDC_C2 222

IDD_RADIO DIALOG 0, 0, 200, 110
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "radio probe"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "A", 100, 4, 4, 60, 60
    CONTROL "A1", IDC_A1, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP | WS_VISIBLE, 10, 14, 40, 12
    CONTROL "A2", IDC_A2, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP | WS_VISIBLE, 10, 28, 40, 12
    CONTROL "A3", IDC_A3, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP | WS_VISIBLE, 10, 42, 40, 12
    CONTROL "B1", IDC_B1, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP | WS_VISIBLE, 70, 14, 40, 12
    CONTROL "B2", IDC_B2, "Button", BS_RADIOBUTTON | WS_TABSTOP | WS_VISIBLE, 70, 28, 40, 12
    CONTROL "C1", IDC_C1, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP | WS_VISIBLE, 130, 14, 40, 12
    CONTROL "C2", IDC_C2, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP | WS_VISIBLE, 130, 28, 40, 12
    DEFPUSHBUTTON   "OK", IDOK, 140, 90, 50, 14, WS_TABSTOP
END
